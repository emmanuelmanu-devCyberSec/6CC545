
# Example environment configuration for the CW2 deployment.
# Copy this file to .env when preparing the deployment.
# Do not place passwords, tokens, private keys or other secrets here.

# --------------------------------------------------
# Docker build configuration
# --------------------------------------------------

# Go image used to build the application.
GO_IMAGE=golang:1.27.3-bookworm

# Current teaching deployment entry point.
APP_PACKAGE=./cmd/deploycheck

# --------------------------------------------------
# Runtime node configuration examples
# --------------------------------------------------
# These variables are read by the application configuration.
# The three Docker nodes use separate values in compose.yaml.
# The examples below are documentation and are not automatically
# passed into containers by Docker Compose.

# Unique node identity.
# NODE_ID=node-a

# Local listening addresses.
# Keep local defaults bound to loopback outside container deployments.
# HTTP_ADDR=127.0.0.1:8081
# TCP_ADDR=
# UDP_ADDR=
# GRPC_ADDR=

# Addresses advertised to other peers.
# Use host:port format without http:// or other URL schemes.
# HTTP_ADVERTISE=node-a:8081
# GRPC_ADVERTISE=node-a:9090

# Local storage directory.
# Defaults to data/<NODE_ID> when not supplied.
# DATA_DIR=data/node-a

# Comma-separated bootstrap peer addresses.
# Use gRPC host:port values.
# PEER_SEEDS=node-b:9090,node-c:9090

# Optional JSON metadata seed file.
# This is separate from PEER_SEEDS.
# SEED=

# Network operation timeout.
# Supported Go duration format, for example 2s, 500ms or 1m.
# NETWORK_TIMEOUT=2s

# Secrets and file-based secret configuration are outside
# this week's scope and will be addressed in Week 9.
